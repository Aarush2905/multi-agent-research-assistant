GEMINI_API_KEY=your_actual_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=120000
# Auto-retry on transient Gemini errors (503 high-demand, 429 rate limit)
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_MIN_WAIT_SECONDS=3
GEMINI_RETRY_MAX_WAIT_SECONDS=20

# Optional providers - leave blank to disable gracefully
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=
NCBI_API_KEY=

# Database
POSTGRES_USER=research_assistant
POSTGRES_PASSWORD=change_me
POSTGRES_DB=research_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://research_assistant:change_me@localhost:5433/research_assistant

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=research_documents

# App
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:5173

# Discovery limits
MAX_QUERIES_PER_RUN=12
MAX_RESULTS_PER_QUERY=10
MAX_TOTAL_SOURCES=40
HTTP_TIMEOUT_SECONDS=20
PROVIDER_RETRY_COUNT=2
MAX_VALIDATION_REPAIR_ATTEMPTS=2
